# Example environment variables (do NOT commit secrets in .env.local)

# --- Blikk API credentials (server-side only) ---
BLIKK_APP_ID=
BLIKK_APP_SECRET=

# Optional overrides
BLIKK_BASE_URL=https://publicapi.blikk.com
BLIKK_TASKS_PATH=/v1/Core/Tasks
BLIKK_TASK_COMMENTS_PATH_TEMPLATE=/v1/Core/Tasks/{id}/Comments
BLIKK_TASK_COMMENT_BODY_KEY=text

# Debug
BLIKK_LOG_BODIES=false
BLIKK_UPDATES_DISABLED=false

# --- Supabase ---
# Public URL used by the app (also used for admin/service clients)
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key (safe to expose to client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side keys
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage
SUPABASE_BUCKET=pdfs

# --- tic.io company/person lookup (server-side only) ---
# API key for the tic.io LENS API (sent as the x-api-key header).
TIC_API_KEY=
# Optional base URL override (defaults to https://lens-api.tic.io)
TIC_API_BASE=

# --- Internal tasks ---
TASKS_DEFAULT_ASSIGNEE_UUID=

# --- Offert: kunduppgifter via länk (token-form) ---
# Email via Resend
# ⚠️ Med en riktig nyckel här SKICKAR även den lokala dev-servern på riktigt.
RESEND_API_KEY=
MAIL_FROM=
# Materialbeställningar till fabriken. Skarpt utskick sker BARA när VERCEL_ENV=production OCH den här är
# exakt "true" — sätt den bara i Vercels Production-scope. Överallt annars finns bara testmail till dig själv.
MATERIAL_ORDER_SEND_ENABLED=
# Avsändare för beställningsmailet (valfri). Default: Ekovilla <order@ekovilla.se>. Svar och kopia går
# alltid till order@ekovilla.se, som måste vara en delad brevlåda någon läser.
MATERIAL_ORDER_MAIL_FROM=
# Optional extra email recipients for felanmälan (comma-separated). The primary recipients are
# the arbetsledare in the fault_report_recipients table; this env is only a fallback/override.
FELANMALAN_NOTIFY_TO=
# Optional absolute app URL used to build deep links in felanmälan emails (falls back to the
# request origin). E.g. https://app.ekovilla.se
NEXT_PUBLIC_APP_URL=
# Notifications auto-cleanup cron (/api/notifications/cleanup) — authorized by CRON_SECRET (Vercel
# cron Bearer). NOTIFICATIONS_CLEANUP_SECRET is an optional manual override for x-cleanup-secret.
NOTIFICATIONS_CLEANUP_SECRET=

# Optional: force correct public origin for links in emails
# (recommended in production)
NEXT_PUBLIC_SITE_URL=

# --- Fortnox (server-side only) ---
# OAuth-appen från Fortnox utvecklarportal. Tokens sparas i databasen (fortnox_integrations), per bolag.
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=
# "test" visar en Testläge-bricka i CRM-inställningarna. Bara en etikett — spärrar ingenting.
FORTNOX_ENVIRONMENT=
# Utanför produktion får bara bolag i den här listan kopplas (testbolaget). Organisationsnummer,
# bindestreck valfritt, separerade med komma. Tom = inget bolag får kopplas. Läses inte i produktion.
# ⚠️ Sätts BARA i .env.development.local — aldrig i .env.local, som pekar på prods databas: där hade
# en koppling av testbolaget skrivit över prods Fortnox-koppling. Se lib/domains/fortnox/connectionGuard.ts.
FORTNOX_NONPROD_ALLOWED_ORG_NUMBERS=

# Next.js
NODE_ENV=development
